# Release signing credentials. Copy this file to keystore.properties (which is gitignored),
# fill in the values, and release builds will be signed automatically.
#
# Create the keystore once with:
#   keytool -genkeypair -v -keystore wallflow-upload.jks -alias wallflow \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep wallflow-upload.jks and this file OUT of version control (both are gitignored).
# With Play App Signing (recommended, default) this is only the *upload* key — Google holds
# the app signing key, and a lost upload key can be reset from the Play Console.

storeFile=wallflow-upload.jks
storePassword=CHANGE_ME
keyAlias=wallflow
keyPassword=CHANGE_ME
